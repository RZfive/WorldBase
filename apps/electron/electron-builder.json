{
  "appId": "com.theworld.app",
  "productName": "WorldBase",
  "afterSign": "scripts/check-macos-permission-signing.cjs",
  "compression": "maximum",
  "electronLanguages": [
    "en-US",
    "zh-CN"
  ],
  "directories": {
    "output": "release"
  },
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/node_modules/pnpm/**"
  ],
  "extraResources": [
    {
      "from": "resources/harness",
      "to": "harness",
      "filter": [
        "**/*"
      ]
    }
  ],
  "files": [
    "package.json",
    {
      "from": "dist",
      "to": "dist",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "dist-electron/electron",
      "to": "dist-electron/electron",
      "filter": [
        "**/*"
      ]
    },
    "!**/*.map",
    "!**/.github/**",
    "!**/.vscode/**",
    "!**/{test,tests,__tests__,powered-test}/**",
    "!**/{example,examples}/**",
    "!**/{doc,docs}/**",
    "!**/*.md",
    "!**/*.markdown",
    "!**/tsconfig.json",
    "!**/*.tsbuildinfo"
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "icon": "public/icon-mac.png",
    "extendInfo": {
      "NSScreenCaptureUsageDescription": "WorldBase needs Screen Recording permission to let Computer Use observe the desktop.",
      "NSAccessibilityUsageDescription": "WorldBase needs Accessibility permission to let Computer Use control the desktop."
    }
  },
  "win": {
    "target": "nsis",
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "include": "build/installer.nsh",
    "installerHeaderIcon": "public/icon.ico",
    "uninstallerIcon": "public/icon.ico"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon.png"
  },
  "dmg": {
    "background": "build/dmg-background.png",
    "window": {
      "width": 660,
      "height": 400
    },
    "contents": [
      {
        "x": 200,
        "y": 268,
        "type": "file"
      },
      {
        "x": 460,
        "y": 268,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
