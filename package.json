{
  "name": "the-world",
  "version": "0.1.0",
  "description": "AI-powered project generator and manager",
  "author": "RZfive",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "node scripts/build-main.mjs && node scripts/build-preload.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron:dev": "vite build && node scripts/build-main.mjs && node scripts/build-preload.mjs && electron .",
    "electron:build": "vite build && node scripts/build-main.mjs && node scripts/build-preload.mjs && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "pako": "^1.0.11",
    "readable-stream": "2.3.8",
    "body-parser": "^1.20.4",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^2.0.6",
    "marked": "^17.0.5",
    "mermaid": "11.14.0",
    "officegen": "^0.6.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^4.0.0",
    "prebuild-install": "^7.1.3",
    "typescript": "^6.0.2",
    "vite": "^4.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "vue": "^3.2.45",
    "vue-tsc": "^3.2.6"
  }
}
