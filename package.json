{
  "name": "the-world-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "WorldBase monorepo workspace orchestrator",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "electron:install": "pnpm --dir apps/electron install --frozen-lockfile",
    "electron:dev": "pnpm --dir apps/electron electron:dev",
    "electron:typecheck": "pnpm --dir apps/electron typecheck",
    "electron:build": "pnpm --dir apps/electron electron:build",
    "electron:build:win": "pnpm --dir apps/electron electron:build:win",
    "electron:build:mac:arm64": "pnpm --dir apps/electron electron:build:mac:arm64",
    "electron:build:linux": "pnpm --dir apps/electron electron:build:linux",
    "electron:test": "pnpm --dir apps/electron test:group-session && pnpm --dir apps/electron test:anthropic-protocol && pnpm --dir apps/electron test:provider-models && pnpm --dir apps/electron test:message-branching",
    "electron:test:im-gateway": "pnpm --dir apps/electron test:im-gateway",
    "harness:build": "cargo build --manifest-path harness-rs/Cargo.toml --release",
    "harness:test": "cargo test --manifest-path harness-rs/Cargo.toml",
    "harness:cli": "cargo run --manifest-path harness-rs/Cargo.toml --bin worldbase --",
    "dev:macos": "bash scripts/dev_macos.sh",
    "dev:android": "bash scripts/dev_android.sh",
    "dev:ios": "bash scripts/dev_ios.sh",
    "harness:test:android-build": "bash -c 'cd harness-rs && RUSTC=\"$HOME/.rustup/toolchains/1.94.1-aarch64-apple-darwin/bin/rustc\" \"$HOME/.rustup/toolchains/1.94.1-aarch64-apple-darwin/bin/cargo\" build -p worldbase-mobile-ffi --target aarch64-linux-android --release'",
    "test:rust": "cargo test --manifest-path harness-rs/Cargo.toml --workspace",
    "test:flutter": "cd apps/mobile && flutter test test/harness_e2e_test.dart test/harness_ffi_test.dart",
    "test:e2e:macos": "cd apps/mobile && flutter test integration_test/app_e2e.dart -d macos"
  }
}
