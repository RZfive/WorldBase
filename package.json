{
  "name": "the-world",
  "version": "0.1.0",
  "description": "AI-powered project generator and manager",
  "author": "RZfive",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-preload.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron:dev": "vite build && tsc -p tsconfig.electron.json && node scripts/build-preload.mjs && electron .",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && node scripts/build-preload.mjs && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "body-parser": "^1.20.4",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "prebuild-install": "^7.1.3",
    "typescript": "^6.0.2",
    "vite": "^4.1.0",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}