{
  "name": "the-world",
  "productName": "WorldBase",
  "version": "1.0.0",
  "description": "AI-powered project generator and manager",
  "author": "RZfive",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm exec vue-tsc --noEmit -p tsconfig.json && pnpm exec tsc --noEmit -p tsconfig.electron.json",
    "build:main": "node scripts/build-main.mjs",
    "build:main:bytecode": "node scripts/build-main.mjs --bytecode",
    "build:preload": "node scripts/build-preload.mjs",
    "build:preload:bytecode": "node scripts/build-preload.mjs --bytecode",
    "build:electron": "pnpm build:main && pnpm build:preload",
    "build:electron:bytecode": "pnpm build:main:bytecode && pnpm build:preload:bytecode",
    "test:group-session": "node --experimental-strip-types --test tests/group-session.test.mjs",
    "test:anthropic-protocol": "node --experimental-strip-types --import ./tests/register-ts-hooks.mjs --test tests/anthropic-protocol.test.mjs",
    "test:im-gateway": "node scripts/im-gateway-smoke.mjs",
    "electron:dev": "pnpm build && pnpm build:electron && pnpm exec electron .",
    "electron:build": "pnpm build && pnpm build:electron:bytecode && pnpm exec electron-builder --publish never",
    "electron:build:win": "pnpm build && pnpm build:electron:bytecode && pnpm exec electron-builder --win --publish never",
    "electron:build:mac:arm64": "pnpm build && pnpm build:electron:bytecode && pnpm exec electron-builder --mac --arm64 --publish never",
    "electron:build:linux": "pnpm build && pnpm build:electron:bytecode && pnpm exec electron-builder --linux --publish never"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.10",
    "better-sqlite3": "^12.8.0",
    "body-parser": "^1.20.4",
    "bytenode": "^1.5.7",
    "emoji-picker-element": "^1.29.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "http-proxy-middleware": "^2.0.6",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "mammoth": "^1.8.0",
    "marked": "^17.0.5",
    "mermaid": "11.14.0",
    "officegen": "^0.6.5",
    "pako": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "pnpm": "10.33.0",
    "qrcode": "^1.5.4",
    "readable-stream": "2.3.8",
    "sharp": "^0.34.4",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^4.0.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "prebuild-install": "^7.1.3",
    "typescript": "^6.0.2",
    "vite": "^4.1.0",
    "vue": "^3.2.45",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
