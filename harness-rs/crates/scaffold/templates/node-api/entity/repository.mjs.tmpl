import { newId, queryRecords, saveRecords } from '../client.mjs'

const TABLE = '{{table_name}}'
const SEARCH_FIELDS = {{search_fields_json}}

function activeFilters (filters = {}) {
  return { ...filters, deleted_at: null }
}

export async function list{{entity_plural_pascal}} (input = {}) {
  return await queryRecords(TABLE, {
    filters: activeFilters(input.filters),
    limit: input.limit,
    offset: input.offset,
    orderBy: input.orderBy ?? '{{order_column}}',
    orderDirection: input.orderDirection ?? 'desc'
  })
}

export async function count{{entity_plural_pascal}} (filters = {}) {
  const rows = await queryRecords(TABLE, {
    filters: activeFilters(filters),
    columns: ['{{id_field}}'],
    limit: 1000
  })
  return rows.length
}

export async function get{{entity_pascal}} (id) {
  const rows = await queryRecords(TABLE, {
    filters: activeFilters({ {{id_field}}: id }),
    limit: 1
  })
  return rows[0] ?? null
}

export async function create{{entity_pascal}} (input) {
  const record = {
    {{id_field}}: {{id_generator}},
    ...(input ?? {}),
    deleted_at: null
  }
{{created_at_setup}}
  await saveRecords(TABLE, [record], 'insert')
