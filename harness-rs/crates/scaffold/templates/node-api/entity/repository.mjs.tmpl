export async function update{{entity_pascal}} (id, input) {
  const existing = await get{{entity_pascal}}(id)
  if (!existing) return null
  const next = { ...existing, ...(input ?? {}), {{id_field}}: id }
  await saveRecords(TABLE, [next], 'upsert')
  return next
}

export async function remove{{entity_pascal}} (id) {
  const existing = await get{{entity_pascal}}(id)
  if (!existing) return false
  const next = { ...existing, deleted_at: new Date().toISOString() }
  await saveRecords(TABLE, [next], 'upsert')
  return true
}

export async function search{{entity_plural_pascal}} (query) {
  const term = query.trim().toLowerCase()
  if (!term) return []
  const rows = await list{{entity_plural_pascal}}({
    limit: 500,
    orderBy: '{{order_column}}',
    orderDirection: 'desc'
  })
  return rows.filter((row) => SEARCH_FIELDS.some((field) => {
    return String(row[field] ?? '').toLowerCase().includes(term)
  }))
}
