import test from 'node:test'
import assert from 'node:assert/strict'
import { readFileSync } from 'node:fs'

function read (path) {
  return readFileSync(new URL(`../${path}`, import.meta.url), 'utf8')
}

const domainFunctions = [
  'list{{entity_plural_pascal}}',
  'get{{entity_pascal}}',
  'create{{entity_pascal}}',
  'update{{entity_pascal}}',
  'remove{{entity_pascal}}',
  'search{{entity_plural_pascal}}'
]

test('{{entity_name}} domain service exposes the SPEC functions', () => {
  const source = read('src/domain/{{entity_name}}-service.mjs')
  for (const name of domainFunctions) {
    assert.match(source, new RegExp(`export async function ${name}\\s*\\(`), name)
  }
})

test('{{entity_name}} repository exposes CRUD functions', () => {
  const source = read('src/data/repositories/{{entity_name}}.mjs')
  for (const name of domainFunctions) {
    assert.match(source, new RegExp(`export async function ${name}\\s*\\(`), name)
  }
})

test('node server exposes {{table_name}} collection and item routes', () => {
  const source = read('server.mjs')
  assert.match(source, /const entityRoutes/)
  assert.ok(source.includes('{{table_name}}'), 'server routes mention the table name')
  assert.ok(source.includes('handlers'), 'entity routes declare HTTP handlers')
})
